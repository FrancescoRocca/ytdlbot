# ========================================== #
#          YTDLBot Configuration             #
# ========================================== #

# Telegram Bot Token (Get this from @BotFather)
BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ========================================== #
#      Local Telegram API Server Setup       #
# ========================================== #

# Required to bypass the 50MB upload limit.
# Get your API ID and Hash from: https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Tells the API server to run in local mode (saving files locally)
TELEGRAM_LOCAL=1

# ========================================== #
#           Bot & Environment Setup          #
# ========================================== #

# Prevents Python from buffering stdout/stderr
PYTHONUNBUFFERED=1

# Points the bot to the local Telegram API container
API_BASE_URL=http://telegram-bot-api:8081/bot

# ========================================== #
#           Advanced Configuration           #
# ========================================== #

# Modify the values below to customize the bot's behavior.
DOWNLOAD_DIR=./videos
READ_TIMEOUT=60
WRITE_TIMEOUT=120
POOL_TIMEOUT=60
CONNECT_TIMEOUT=30
MAX_RETRIES=5

VIDEO_FORMAT=bestvideo+bestaudio/best
MERGE_FORMAT=mp4
